[Unit]
Description=Junna shared workbench MCP and editor
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/junna-workbench/current
ExecStart=/usr/local/bin/node /opt/junna-workbench/current/run-server.cjs
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/junna-workbench /var/www/junna

[Install]
WantedBy=multi-user.target
