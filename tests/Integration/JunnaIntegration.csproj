<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Sts2Api Condition="'$(Sts2Api)' == ''">beta</Sts2Api>
    <DefineConstants Condition="'$(Sts2Api)' == 'beta'">$(DefineConstants);STS2_BETA</DefineConstants>
    <JunnaAssemblyPath Condition="'$(JunnaAssemblyPath)' == ''">../../dist/ShoujoKagekiJunna/lib/ShoujoKagekiJunna.Beta.dll</JunnaAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShoujoKagekiAijoCore.Api.V1" HintPath="$(CoreApiPath)" />
    <Reference Include="ShoujoKagekiJunna" HintPath="$(JunnaAssemblyPath)" />
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" />
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" />
  </ItemGroup>
</Project>
