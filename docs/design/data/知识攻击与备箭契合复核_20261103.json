  "cards": [
    {
      "id": "JK44",
      "name": "论证",
      "art": "original-scene-jb05-arrow-flight-20261103",
      "source": "2021 剧场版 · 狩猎的Revue片段约02:57",
      "fit": "将学到的内容组织为有依据的判断，以引言最终化为箭矢飞出的原作场面表现知识被用于攻击。关联疑问呈现论证中仍需澄清的问题。名称沿用已删除牌JX09释放的论证契合；配图重新分配自已删除牌JB05，保留箭头、箭杆和箭羽的完整轮廓。原始截图：film-arrow-256-20261103.png。"
    },
    {
      "id": "JK49",
      "name": "折不断的笔",
      "art": "original-scene-jk49-unbroken-pen-attack-20261103",
      "source": "2021 剧场版 ·《ペン：力：刀》（歌词）／狩猎的Revue纯那持刀进攻镜头（配图）",
      "fit": "卡名取同段歌词的连续原词，以笔承载思考与表达，再以纯那主动持刀推进的原作动作表现表达的力量。攻击后回到思考，整理后再次展开表达，保持同一张牌的往复变化。歌词与配图分别记录，配图保留纯那前压的身体、握刀的双手与指向对手的刀刃。原始截图：film-knowledge-pen-action-0731-20261103.jpg；裁切：675,310,535,401。"
    },
    {
      "id": "JA53",
      "name": "备箭",
      "art": "original-scene-ja56-20261102",
      "source": "TV 第2话 · 配图约19:22",
      "fit": "卡图取纯那握稳低位弓身的静态手部与装备，弦尚未拉开，画面没有飞出的箭。整理装备的准备动作对应格挡与抽取箭矢。配图重新分配自已删除牌JA56，沿用已登记的TV第2话握弓细节。"
    }
  ],
